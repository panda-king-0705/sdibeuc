# ---------------------------------------------------------------------------
# sdibeuc — environment template. Copy to `.env` and fill in your own values.
# This is YOUR deployment, pointed at YOUR backend. No third-party product keys.
# ---------------------------------------------------------------------------

# --- Web app (apps/web, Vite — only VITE_ vars reach the browser) ---
VITE_APP_NAME=sdibeuc
VITE_API_URL=http://localhost:8787

# --- Backend / database (self-hosted; Supabase suggested) ---
# Public (safe to ship to the client):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only — NEVER expose to the client bundle:
SUPABASE_SERVICE_ROLE_KEY=

# --- Mobile shell (apps/mobile, Expo — only EXPO_PUBLIC_ vars reach the app) ---
# The deployed URL of your own web app that the WebView loads:
EXPO_PUBLIC_WEB_URL=https://your-domain.example.com
# Expo push (optional):
EXPO_ACCESS_TOKEN=

# --- Deal seeding (optional) ---
# Set a fixed integer to make the server deal reproducible boards; leave blank for random.
DEAL_SEED=
